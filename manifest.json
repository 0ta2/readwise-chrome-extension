{
   "action": {
      "default_icon": "icons/icon19.png",
      "default_title": "Readwise For amazon.co.jp"
   },
   "background": {
      "service_worker": "src/bg/index.js",
      "type": "module"
   },
   "content_scripts": [ {
      "all_frames": true,
      "css": [ "src/inject/inject.css" ],
      "matches": [ "*://read.amazon.co.jp/*", "*://*.readwise.io/*" ]
   }, {
      "all_frames": true,
      "js": [ "js/jquery/jquery.min.js", "js/js-cookie.js", "src/inject/inject.js" ],
      "matches": [ "*://read.amazon.co.jp/*", "*://*.readwise.io/*" ]
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'"
   },
   "default_locale": "en",
   "description": "Use the Readwise Chrome Extension to sync your Kindle highlights and then review them daily.",
   "homepage_url": "https://readwise.io",
   "host_permissions": [ "*://read.amazon.co.jp/*", "*://*.readwise.io/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Readwise_for_amazon.co.jp",
   "permissions": [ "notifications", "cookies", "storage", "alarms", "contextMenus" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.1.1",
   "web_accessible_resources": [ {
      "matches": [ "*://read.amazon.co.jp/*", "*://*.readwise.io/*" ],
      "resources": [ "src/inject/newLoadAllQuotes.js" ]
   } ]
}
